<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS reverse proxy for File Browser (ppv-storage-ss.intel.com -> http://127.0.0.1:8006).
     Requires IIS URL Rewrite + Application Request Routing with "Enable proxy" turned on. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Forward everything (UI, /static, /api) unchanged. UNENCODED_URL keeps file names with %, #, + intact. -->
        <rule name="PPVSTORAGE" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:8006{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <!-- IIS defaults would block file names such as web.config, *.cs, bin/ or names containing "+". -->
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="4294967295" />
        <fileExtensions allowUnlisted="true">
          <clear />
        </fileExtensions>
        <hiddenSegments>
          <clear />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
